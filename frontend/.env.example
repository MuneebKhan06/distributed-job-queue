# Where the Vite dev server forwards /api requests.
VITE_API_TARGET=http://localhost:8000

# Base path the browser uses for API calls. Leave as /api to go through the
# dev proxy, or point it at a deployed API that allows this origin.
VITE_API_BASE_URL=/api

# Where the dev server forwards /prom requests. Throughput and failure rates
# on the overview come from here, because only Prometheus sums the workers.
VITE_PROMETHEUS_TARGET=http://localhost:9090
VITE_PROMETHEUS_BASE_URL=/prom
