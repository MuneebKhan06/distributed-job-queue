FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY worker ./worker

RUN useradd --create-home --uid 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Prometheus scrape port for this worker process.
EXPOSE 9100

# No migrations here. Several workers start at once and concurrent `alembic
# upgrade head` runs race each other for the version table.
CMD ["python", "-m", "worker.main"]
