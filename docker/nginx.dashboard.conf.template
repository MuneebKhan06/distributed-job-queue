# Serves the built dashboard and proxies the two backends it talks to, so the
# browser sees one origin in production exactly as it does behind the Vite dev
# server, and the API still needs no CORS configuration.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;

    # The bundle is plain text and shrinks to about a third. Off by default in
    # the stock image. Proxied API and Prometheus replies are compressed too,
    # which matters for the DLQ list and the chart's range queries on a slow
    # link. text/html is always included by nginx and must not be listed.
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json text/plain image/svg+xml;
    gzip_vary on;

    include /etc/nginx/snippets/security-headers.conf;

    # Docker's embedded DNS. Upstreams are looked up per request through
    # variables, rather than once at start. A fixed proxy_pass host that does
    # not resolve stops nginx from starting at all, which would tie the
    # dashboard's uptime to Prometheus, an optional service.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};
    set $prometheus_upstream ${PROMETHEUS_UPSTREAM};

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
    }

    location /prom/ {
        rewrite ^/prom/(.*)$ /$1 break;
        proxy_pass http://$prometheus_upstream;
        proxy_set_header Host $host;
    }

    # Vite puts a content hash in every asset name, so an asset never changes
    # under its URL and can be cached for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # index.html names the current assets, so it must always be fetched fresh
    # or a deploy leaves browsers asking for files that no longer exist.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
