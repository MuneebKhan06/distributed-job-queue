# Copy to .env and adjust. Every value here has a default in app/config.py,
# so .env only needs the ones you actually want to override.

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=jobqueue
POSTGRES_PASSWORD=jobqueue
POSTGRES_DB=jobqueue
# DATABASE_URL is derived from the values above. Set it only to point somewhere
# else entirely (a managed instance, a test database).
# DATABASE_URL=postgresql+asyncpg://jobqueue:jobqueue@postgres:5432/jobqueue

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://redis:6379/0

# Worker
WORKER_BATCH_SIZE=10
WORKER_BLOCK_MS=5000
# For every job taken off the normal stream, take this many off the high one.
HIGH_PRIORITY_WEIGHT=3

# Retries
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60
MAX_ATTEMPTS=5

# Metrics
WORKER_METRICS_PORT=9100
